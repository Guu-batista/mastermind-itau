## Postgres (docker-compose)
POSTGRES_DB=mastermind
POSTGRES_USER=mastermind
POSTGRES_PASSWORD=mastermind
POSTGRES_PORT=5432

## Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://mastermind:mastermind@localhost:5432/mastermind
JWT_SECRET=change_me_in_local_env
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

